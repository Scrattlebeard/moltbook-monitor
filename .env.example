# Moltbook Monitor Configuration

# Required: Your Moltbook API key (obtain from /agents/register endpoint)
MOLTBOOK_API_KEY=your_api_key_here

# Optional: Base URL for Moltbook API (default shown)
# MOLTBOOK_BASE_URL=https://www.moltbook.com/api/v1

# Optional: Interval between scrape cycles in seconds (default: 60)
# SCRAPE_INTERVAL_SECONDS=60

# Optional: Number of posts to fetch per request (default: 25)
# POSTS_LIMIT=25

# Optional: Log level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# Optional: Output file for flagged posts (default: flagged_posts.json)
# OUTPUT_FILE=flagged_posts.json
